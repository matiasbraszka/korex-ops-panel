# Portal del cliente — mismas credenciales del proyecto Supabase de Korex.
# Proyecto: cgdwieoxjoexzlfbxrfc (el mismo que usa el panel de operaciones).
# Copiá este archivo a .env y completá los valores (la anon key está en
# korex-ops-panel/apps/operations/.env).

VITE_SUPABASE_URL=https://cgdwieoxjoexzlfbxrfc.supabase.co
VITE_SUPABASE_ANON_KEY=

# Bucket de Supabase Storage donde caen fotos/recursos del cliente.
VITE_STORAGE_BUCKET=funnel-recursos

# Modo prueba del onboarding: se puede recorrer el flujo entero tocando todo
# (reservar horario, subir archivos, terminar) sin que se dispare nada real —
# ni citas, ni WhatsApps, ni write-back del cerebro, ni Slack.
#
# En `npm run dev` YA VIENE PRENDIDO por defecto y no hace falta setear nada.
# Esta variable solo sirve para dejarlo prendido en un build (`npm run build`),
# por ejemplo un preview para mostrarle el flujo a alguien.
#
# NUNCA ponerla en 1 en el deploy de producción del portal.
# VITE_ONB_DEMO=1
